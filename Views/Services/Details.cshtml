@model ServiceApplication
@{
    ViewData["Title"] = "Application Details - Flyzone";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/flyzone-auth.css" asp-append-version="true" />
    <style>
        .form-card {
            background: transparent;
            border-radius: 12px;
            padding: 0;
            max-width: 900px;
            margin: 0 auto;
        }
        .form-header {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            text-align: center;
            margin-bottom: 1.5rem;
            padding: 2rem;
            border-bottom: 2px solid #f0f0f0;
        }
        .form-header h2 {
            color: var(--fz-dark);
            font-weight: 600;
        }
        .flow-nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem 1.25rem;
            margin-bottom: 1.5rem;
        }
        .detail-panel {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <a href="@Url.Action("Dashboard", "Account")" class="back-to-home">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>

    <div class="auth-wrapper">
        <div class="form-card">
            <div class="form-header">
                <a href="@Url.Action("Index", "Home")" class="brand-logo d-block text-center mb-3">
                    <i class="fa-solid fa-feather-pointed me-2" style="color: var(--fz-green);"></i>FLY<span>ZONE</span>
                </a>
                <h2><i class="fa-solid fa-file-circle-check me-2"></i>Application Details</h2>
                <p class="text-muted small mb-0">Reference: <span class="fw-semibold">@Model.Id</span></p>
            </div>

            <nav class="flow-nav" aria-label="Applicant navigation">
                <a href="@Url.Action("Upload", "Services")" class="fw-semibold text-decoration-none">Upload Document</a>
                <a href="@Url.Action("MyDocuments", "Services")" class="text-decoration-none">My Documents</a>
                <a href="@Url.Action("Track", "Services")" class="text-decoration-none">Track Status</a>
            </nav>

            <section class="detail-panel">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <h5 class="fw-bold mb-0">@(Model.Service?.ServiceName ?? "Unknown service")</h5>
                    <span class="badge bg-dark px-3 py-2">@Model.Status</span>
                </div>
                <div class="row g-3 small text-muted">
                    <div class="col-sm-6">
                        <i class="fa-solid fa-calendar-plus me-2"></i>Submitted:
                        <span class="fw-semibold text-dark">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="col-sm-6">
                        <i class="fa-solid fa-calendar-check me-2"></i>Last updated:
                        <span class="fw-semibold text-dark">@Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>
            </section>

            <section class="detail-panel">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-paperclip me-2" style="color: var(--fz-green);"></i>Attached Documents</h5>
                    <a href="@Url.Action("Upload", "Services")" class="btn btn-sm btn-outline-primary text-decoration-none">
                        <i class="fa-solid fa-file-arrow-up me-1"></i> Upload Document
                    </a>
                </div>
                @if (Model.AttachedDocuments.Count == 0)
                {
                    <p class="text-muted mb-0">No documents are attached to this application yet.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var document in Model.AttachedDocuments)
                        {
                            <li class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom py-2">
                                <span><i class="fa-regular fa-file me-2 text-muted"></i>@document.DocumentType</span>
                                <a href="@Url.Action("DownloadDocument", "Services", new { id = document.Id })"
                                   class="btn btn-sm btn-outline-primary text-decoration-none">
                                    <i class="fa-solid fa-download me-1"></i> Download
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>

            @await Html.PartialAsync("_Timeline", Model)
        </div>
    </div>
</body>
</html>
