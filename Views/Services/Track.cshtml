@model TrackViewModel
@{
    ViewData["Title"] = "Track Application - Flyzone";
    Layout = null;
    var application = Model.Application;
    var hasReference = !string.IsNullOrWhiteSpace(Model.Reference);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/flyzone-auth.css" asp-append-version="true" />
    <style>
        .form-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            max-width: 900px;
            margin: 0 auto;
        }
        .form-header {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid #f0f0f0;
        }
        .form-header h2 {
            color: var(--fz-dark);
            font-weight: 600;
        }
        .flow-nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem 1.25rem;
            margin-bottom: 1.5rem;
        }
        .result-panel {
            background: #f8faf9;
            border-radius: 12px;
            padding: 1.5rem;
            margin-top: 1.5rem;
        }
    </style>
</head>
<body>
    <a href="@Url.Action("Dashboard", "Account")" class="back-to-home">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>

    <div class="auth-wrapper">
        <div class="form-card">
            <div class="form-header">
                <a href="@Url.Action("Index", "Home")" class="brand-logo d-block text-center mb-3">
                    <i class="fa-solid fa-feather-pointed me-2" style="color: var(--fz-green);"></i>FLY<span>ZONE</span>
                </a>
                <h2><i class="fa-solid fa-magnifying-glass me-2"></i>Track Application</h2>
                <p class="text-muted small mb-0">Enter your application reference number to see its status</p>
            </div>

            <nav class="flow-nav" aria-label="Applicant navigation">
                <a href="@Url.Action("Upload", "Services")" class="fw-semibold text-decoration-none">Upload Document</a>
                <a href="@Url.Action("MyDocuments", "Services")" class="text-decoration-none">My Documents</a>
                <a href="@Url.Action("Track", "Services")" class="text-decoration-none">Track Status</a>
            </nav>

            <form asp-controller="Services" asp-action="Track" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-sm-9">
                        <label for="reference" class="form-label fw-semibold">
                            <i class="fa-solid fa-hashtag me-2 text-muted"></i>Application reference
                        </label>
                        <input type="text" class="form-control" id="reference" name="reference"
                               value="@Model.Reference" placeholder="Paste the reference number from your confirmation" />
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-auth-primary w-100">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                        </button>
                    </div>
                </div>
            </form>

            @if (application != null)
            {
                <div class="result-panel">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div>
                            <span class="text-muted small d-block">@application.Id</span>
                            <strong class="fs-5">@(application.Service?.ServiceName ?? "Unknown service")</strong>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-dark px-3 py-2">@application.Status</span>
                            <a href="@Url.Action("Details", "Services", new { id = application.Id })"
                               class="btn btn-sm btn-outline-primary text-decoration-none">
                                <i class="fa-solid fa-circle-info me-1"></i> View details
                            </a>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    @await Html.PartialAsync("_Timeline", application)
                </div>
            }
            else if (hasReference)
            {
                <div class="result-panel text-center mt-4">
                    <i class="fa-solid fa-magnifying-glass text-muted fs-1 mb-3"></i>
                    <p class="text-muted mb-0">No application found with that reference number.</p>
                </div>
            }
            else
            {
                <div class="result-panel text-center mt-4">
                    <i class="fa-solid fa-circle-info text-muted fs-1 mb-3"></i>
                    <p class="text-muted mb-0">Enter your application reference number above to see its progress.</p>
                </div>
            }
        </div>
    </div>
</body>
</html>
