@{
    ViewData["Title"] = "Upload Document - Flyzone";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/flyzone-auth.css" asp-append-version="true" />
    <style>
        .form-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            max-width: 700px;
            margin: 0 auto;
        }
        .form-header {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid #f0f0f0;
        }
        .form-header h2 {
            color: var(--fz-dark);
            font-weight: 600;
        }
        .flow-nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem 1.25rem;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <a href="@Url.Action("Dashboard", "Account")" class="back-to-home">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>

    <div class="auth-wrapper">
        <div class="form-card">
            <div class="form-header">
                <a href="@Url.Action("Index", "Home")" class="brand-logo d-block text-center mb-3">
                    <i class="fa-solid fa-feather-pointed me-2" style="color: var(--fz-green);"></i>FLY<span>ZONE</span>
                </a>
                <h2><i class="fa-solid fa-file-arrow-up me-2"></i>Upload Document</h2>
                <p class="text-muted small mb-0">PDF, JPG or PNG &middot; maximum 5 MB per file</p>
            </div>

            <nav class="flow-nav" aria-label="Applicant navigation">
                <a href="@Url.Action("Upload", "Services")" class="fw-semibold text-decoration-none">Upload Document</a>
                <a href="@Url.Action("MyDocuments", "Services")" class="text-decoration-none">My Documents</a>
                <a href="@Url.Action("Track", "Services")" class="text-decoration-none">Track Status</a>
            </nav>

            <form asp-controller="Services" asp-action="UploadDocument" method="post"
                  enctype="multipart/form-data" asp-antiforgery="true">
                <div class="mb-4">
                    <label for="documentFile" class="form-label fw-semibold">
                        <i class="fa-solid fa-paperclip me-2 text-muted"></i>Document file
                    </label>
                    <input type="file" class="form-control" id="documentFile" name="file"
                           accept=".pdf,.jpg,.jpeg,.png" required />
                    <div class="form-text">Accepted formats: PDF, JPG, JPEG, PNG (up to 5 MB).</div>
                </div>

                <div class="mb-4">
                    <label for="documentType" class="form-label fw-semibold">
                        <i class="fa-solid fa-tag me-2 text-muted"></i>Document type
                    </label>
                    <select class="form-select" id="documentType" name="documentType" required>
                        <option value="Passport">Passport</option>
                        <option value="EmiratesId">Emirates ID</option>
                        <option value="DrivingLicense">Driving License</option>
                        <option value="ProofOfAddress">Proof of Address</option>
                        <option value="Photo">Photo</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label for="applicationId" class="form-label fw-semibold">
                        <i class="fa-solid fa-hashtag me-2 text-muted"></i>Application reference <span class="text-muted fw-normal">(optional)</span>
                    </label>
                    <input type="text" class="form-control" id="applicationId" name="applicationId"
                           placeholder="Leave blank to upload without linking an application" />
                </div>

                <button type="submit" class="btn btn-auth-primary w-100 mb-3">
                    <i class="fa-solid fa-cloud-arrow-up me-2"></i> Upload Document
                </button>

                <div class="text-center">
                    <a href="@Url.Action("MyDocuments", "Services")" class="text-decoration-none small">
                        View my documents <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
