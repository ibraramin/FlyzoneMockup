@model List<UserDocument>
@{
    ViewData["Title"] = "My Documents - Flyzone";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/flyzone-auth.css" asp-append-version="true" />
    <style>
        .form-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            max-width: 900px;
            margin: 0 auto;
        }
        .form-header {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid #f0f0f0;
        }
        .form-header h2 {
            color: var(--fz-dark);
            font-weight: 600;
        }
        .flow-nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem 1.25rem;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <a href="@Url.Action("Dashboard", "Account")" class="back-to-home">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>

    <div class="auth-wrapper">
        <div class="form-card">
            <div class="form-header">
                <a href="@Url.Action("Index", "Home")" class="brand-logo d-block text-center mb-3">
                    <i class="fa-solid fa-feather-pointed me-2" style="color: var(--fz-green);"></i>FLY<span>ZONE</span>
                </a>
                <h2><i class="fa-solid fa-folder-open me-2"></i>My Documents</h2>
                <p class="text-muted small mb-0">All documents you have uploaded, newest first</p>
            </div>

            <nav class="flow-nav" aria-label="Applicant navigation">
                <a href="@Url.Action("Upload", "Services")" class="fw-semibold text-decoration-none">Upload Document</a>
                <a href="@Url.Action("MyDocuments", "Services")" class="text-decoration-none">My Documents</a>
                <a href="@Url.Action("Track", "Services")" class="text-decoration-none">Track Status</a>
            </nav>

            <div class="mb-4 text-center">
                <a href="@Url.Action("Upload", "Services")" class="btn btn-auth-primary">
                    <i class="fa-solid fa-file-arrow-up me-2"></i> Upload Document
                </a>
            </div>

            @if (Model.Count == 0)
            {
                <div class="text-center py-4">
                    <i class="fa-solid fa-folder-open text-muted fs-1 mb-3"></i>
                    <p class="text-muted mb-0">You have not uploaded any documents yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th class="ps-3 py-3 fw-semibold">Document Type</th>
                                <th class="py-3 fw-semibold">Uploaded</th>
                                <th class="py-3 fw-semibold">Verification</th>
                                <th class="pe-3 py-3 fw-semibold">File</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="ps-3 py-3 fw-semibold">@document.DocumentType</td>
                                    <td class="py-3 text-muted">@document.UploadedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td class="py-3">
                                        <span class="badge @(document.IsVerified ? "bg-success" : "bg-secondary") rounded-pill">
                                            @(document.IsVerified ? "Verified" : "Pending")
                                        </span>
                                    </td>
                                    <td class="pe-3 py-3">
                                        <a href="@Url.Action("DownloadDocument", "Services", new { id = document.Id })"
                                           class="btn btn-sm btn-outline-primary text-decoration-none">
                                            <i class="fa-solid fa-download me-1"></i> Download
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</body>
</html>
