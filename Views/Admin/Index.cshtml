@model List<ServiceApplication>
@{
    ViewData["Title"] = "Admin Queue - Flyzone";
    Layout = null;
    var filter = ViewData["StatusFilter"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/flyzone-auth.css" asp-append-version="true" />
</head>
<body>
    <a href="@Url.Action("Dashboard", "Account")" class="back-to-home">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>

    <div class="auth-wrapper">
        <div class="form-card" style="max-width: 1100px;">
            <div class="form-header">
                <h2><i class="fa-solid fa-shield-halved me-2"></i>Admin Review Queue</h2>
                <p class="text-muted small mb-0">@Model.Count application(s) @(string.IsNullOrWhiteSpace(filter) ? "" : $"matching {filter}")</p>
            </div>

            <form method="get" class="row g-2 align-items-end mb-4">
                <div class="col-sm-8">
                    <label for="status" class="form-label fw-semibold small">Status filter</label>
                    <select class="form-select" id="status" name="status">
                        <option value="">All statuses</option>
                        @foreach (var value in Enum.GetValues<ApplicationStatus>())
                        {
                            <option value="@value" selected="@(filter == value.ToString())">@value</option>
                        }
                    </select>
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-auth-primary w-100"><i class="fa-solid fa-filter me-1"></i> Apply</button>
                </div>
            </form>

            @if (Model.Count == 0)
            {
                <p class="text-muted text-center py-4 mb-0">No applications match this filter.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th class="ps-3 py-3">Reference</th>
                                <th class="py-3">Applicant</th>
                                <th class="py-3">Service</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Submitted</th>
                                <th class="pe-3 py-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="ps-3 py-3 small text-muted">@item.Id</td>
                                    <td class="py-3">@(item.User?.Email ?? "Unknown")</td>
                                    <td class="py-3">@(item.Service?.ServiceName ?? "Unknown service")</td>
                                    <td class="py-3"><span class="badge bg-dark rounded-pill">@item.Status</span></td>
                                    <td class="py-3 text-muted small">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="pe-3 py-3">
                                        <a href="@Url.Action("Details", "Admin", new { id = item.Id })" class="btn btn-sm btn-outline-primary text-decoration-none">
                                            <i class="fa-solid fa-circle-info me-1"></i> Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</body>
</html>
