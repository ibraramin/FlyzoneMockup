@model ServiceApplication
@{
    ViewData["Title"] = "Review Application - Flyzone";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/flyzone-auth.css" asp-append-version="true" />
</head>
<body>
    <a href="@Url.Action("Index", "Admin")" class="back-to-home">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Review Queue
    </a>

    <div class="auth-wrapper">
        <div class="form-card" style="max-width: 900px;">
            <div class="form-header">
                <h2><i class="fa-solid fa-file-circle-check me-2"></i>Review Application</h2>
                <p class="text-muted small mb-0">Reference: <span class="fw-semibold">@Model.Id</span></p>
            </div>

            <section class="mb-4">
                <h5 class="fw-bold mb-3">@(Model.Service?.ServiceName ?? "Unknown service")</h5>
                <div class="row g-3 small text-muted">
                    <div class="col-sm-6">Applicant: <span class="fw-semibold text-dark">@(Model.User?.Email ?? "Unknown")</span></div>
                    <div class="col-sm-6">Current status: <span class="badge bg-dark">@Model.Status</span></div>
                    <div class="col-sm-6">Submitted: <span class="fw-semibold text-dark">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span></div>
                    <div class="col-sm-6">Documents attached: <span class="fw-semibold text-dark">@Model.AttachedDocuments.Count</span></div>
                </div>
            </section>

            <form asp-controller="Admin" asp-action="Update" method="post" class="border-top pt-4 mb-5">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label for="status" class="form-label fw-semibold">New status</label>
                    <select class="form-select" id="status" name="status">
                        @foreach (var value in Enum.GetValues<ApplicationStatus>())
                        {
                            <option value="@value" selected="@(value == Model.Status)">@value</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label fw-semibold">History comment <span class="text-muted fw-normal">(optional)</span></label>
                    <input class="form-control" id="comment" name="comment" maxlength="300" />
                </div>
                <div class="mb-4">
                    <label for="internalNotes" class="form-label fw-semibold">Internal notes <span class="text-muted fw-normal">(admin only)</span></label>
                    <textarea class="form-control" id="internalNotes" name="internalNotes" rows="3" maxlength="1000">@Model.InternalNotes</textarea>
                </div>
                <button type="submit" class="btn btn-auth-primary w-100">
                    <i class="fa-solid fa-floppy-disk me-2"></i> Save Transition
                </button>
            </form>

            @await Html.PartialAsync("~/Views/Services/_Timeline.cshtml", Model)
        </div>
    </div>
</body>
</html>
